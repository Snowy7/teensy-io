[Unit]
Description=Teensy IO ROS2 bridge
After=network.target

[Service]
Type=simple
User=robot
Group=dialout
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/robot/teensy-io-ws/install/setup.bash && ros2 launch teensy_io_ros bridge.launch.py'
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
